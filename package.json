{
  "name": "mn-lake-homes-hardened",
  "version": "1.0.0",
  "description": "MN Lake Homes Platform Native Node.js & PostgreSQL Hardening",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:seed:staging": "NODE_ENV=staging node scripts/seed-staging.js",
    "test:guard": "node test/schema-guard.test.js",
    "test:towns": "node test/town-visibility.test.js",
    "test": "node test/schema-guard.test.js && node test/town-visibility.test.js && node test/manual-release.test.js && node test/lifecycle.test.js && node test/admin-auth.test.js",
    "test:manual": "node test/manual-release.test.js",
    "test:auth": "node test/admin-auth.test.js"
  },
  "dependencies": {
    "@sentry/node": "^8.47.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "openai": "^6.34.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.5",
    "resend": "^6.12.0",
    "stripe": "^22.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pg-mem": "^3.0.14",
    "playwright": "^1.61.0"
  }
}
